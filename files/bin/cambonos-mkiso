#!/usr/bin/env bash

set -Eeuo pipefail

readonly TITLE='CambonOS ISO Builder'
readonly PACKAGED_PROFILE='/usr/share/cambonos-mkiso/profile'
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

WORK_DIR=''
REPOSITORY_NAME='cambonos'
REPOSITORY_CHANNEL='stable'

usage() {
	cat <<'EOF'
Uso: cambonos-mkiso [--testing]

Genera una ISO de CambonOS. Por defecto utiliza el canal stable; --testing
selecciona el repositorio CambonOS testing. Solicita el directorio de salida y
requiere root, archiso, grub y conexión a Internet.
EOF
}

fail() {
	printf 'ERROR: %s\n' "$1" >&2
	exit 1
}

cleanup() {
	if [[ -n "$WORK_DIR" && -d "$WORK_DIR" ]]; then
		rm -rf -- "$WORK_DIR"
	fi
}

require_commands() {
	local missing=()
	local command_name
	for command_name in "$@"; do
		command -v "$command_name" >/dev/null 2>&1 || missing+=("$command_name")
	done
	((${#missing[@]} == 0)) || fail "Faltan comandos necesarios: ${missing[*]}"
}

select_repository() {
	case "${1:-}" in
		'') ;;
		--testing)
			REPOSITORY_NAME='cambonos-testing'
			REPOSITORY_CHANNEL='testing'
			;;
		*) return 2 ;;
	esac
}

repository_configuration() {
	printf '[%s]\nSigLevel = Required TrustedOnly\nServer = https://mirror.cambonos.org/%s/$arch\n' \
		"$REPOSITORY_NAME" "$REPOSITORY_CHANNEL"
}

append_repository_configuration() {
	local pacman_conf=$1
	printf '\n' >> "$pacman_conf"
	repository_configuration >> "$pacman_conf"
}

write_live_repository_configuration() {
	local pacman_conf="$PROFILE_DIR/airootfs/etc/pacman.conf"
	mkdir -p "$(dirname "$pacman_conf")"
	cat > "$pacman_conf" <<'EOF'
[options]
Architecture = auto
HoldPkg = pacman glibc
ParallelDownloads = 5
SigLevel = Required DatabaseOptional
LocalFileSigLevel = Optional

[core]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist

EOF
	repository_configuration >> "$pacman_conf"
}

stage_desktops() {
	local source_dir
	mkdir -p "$PROFILE_DIR/airootfs/root"
	for source_dir in xfce qtile; do
		git clone --depth 1 "https://github.com/Cambon18/${source_dir}.git" "$WORK_DIR/$source_dir"
		[[ -f "$WORK_DIR/$source_dir/archie.sh" ]] || fail "El repositorio $source_dir no contiene archie.sh."
		cp -a "$WORK_DIR/$source_dir" "$PROFILE_DIR/airootfs/root/$source_dir"
	done
}

write_iso_metadata() {
	local iso_name_value="CambonOS"
	local iso_tag_suffix=''

	if [[ "$REPOSITORY_CHANNEL" == 'testing' ]]; then
		iso_tag_suffix='-testing'
	fi

	iso_name_value="CambonOS${iso_tag_suffix}"

	sed -i \
		-e "s|^iso_name=.*|iso_name=\"${iso_name_value}\"|" \
		-e "s|^iso_label=.*|iso_label=\"CambonOS${iso_tag_suffix}_\$(date +%Y.%m)\"|" \
		-e "s|^iso_version=.*|iso_version=\"\$(date +%Y.%m)\"|" \
		"$PROFILE_DIR/profiledef.sh"
}

prepare_profile() {
	local source_dir
	if [[ -d "$PACKAGED_PROFILE" ]]; then
		source_dir=$PACKAGED_PROFILE
	elif [[ -d "$SCRIPT_DIR/../profile" ]]; then
		source_dir="$SCRIPT_DIR/../profile"
	else
		fail 'No se encontró el perfil ArchISO incluido con cambonos-mkiso.'
	fi

	PROFILE_DIR="$WORK_DIR/profile"
	mkdir -p "$PROFILE_DIR"
	cp -a "$source_dir/." "$PROFILE_DIR/"

	append_repository_configuration "$PROFILE_DIR/pacman.conf"
	write_iso_metadata
	write_live_repository_configuration
}

main() {
	local output_dir
	if (($# > 1)); then
		usage >&2
		return 2
	fi
	case "${1:-}" in
		-h|--help) usage; return 0 ;;
		*) select_repository "${1:-}" || { usage >&2; return 2; } ;;
	esac
	[[ $EUID -eq 0 ]] || fail 'Debe ejecutarse como root, por ejemplo: sudo cambonos-mkiso'
	require_commands mkarchiso grub-mkstandalone git cp mkdir mktemp realpath sed

	output_dir=$PWD
	read -r -e -i "$output_dir" -p 'Directorio de salida de la ISO: ' output_dir
	[[ -n "$output_dir" ]] || fail 'El directorio de salida no puede estar vacío.'
	mkdir -p -- "$output_dir"
	output_dir=$(realpath -m -- "$output_dir")

	WORK_DIR=$(mktemp -d /tmp/cambonos-mkiso.XXXXXX)
	prepare_profile
	stage_desktops

	printf 'Generando ISO en %s\n' "$output_dir"
	mkarchiso -v -w "$WORK_DIR/work" -o "$output_dir" "$PROFILE_DIR"
	printf 'ISO generada correctamente en %s\n' "$output_dir"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	trap cleanup EXIT
	main "$@"
fi
